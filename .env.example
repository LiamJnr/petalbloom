# Set these as encrypted Cloudflare Pages secrets. Do not commit a real .env file.
HANDYPAY_API_KEY=
HANDYPAY_WEBHOOK_SECRET=
# Currency code: GHS, NGN, USD, ZAR, etc. Defaults to GHS if omitted.
HANDYPAY_CURRENCY=GHS
# USD to GHS exchange rate for product price conversion (defaults to 11.17 if omitted)
HANDYPAY_EXCHANGE_RATE=11.17
# Random secret used to hash client IPs for API rate limiting. Generate a long
# random value and set it as an encrypted Cloudflare Pages secret.
RATE_LIMIT_SALT=
